#include <stdio.h>
#include <stdint.h>
#define LED_PIO_BASE 0x00001000u /* adresse base des LED (exemple) */
#define SW_PIO_BASE 0x00001040u /* adresse base des interrupteurs */


int main()
{
  printf("Hello from Nios II!\n");

  /* pointeurs volatils vers les registres Data */
   volatile uint32_t *led_pio = (uint32_t *)LED_PIO_BASE;
   volatile uint32_t *sw_pio = (uint32_t *)SW_PIO_BASE;
   while (1) {
   uint32_t sw_value = *sw_pio; /* lit les 10 bits des interrupteurs */
   *led_pio = sw_value; /* écrit le motif sur les LED */
   }
  return 0;
}
